#!/bin/sh
export APPDIR="$(realpath "$(dirname "$0")")"
export PATH="$APPDIR/usr/bin${PATH:+:$PATH}"

[ -d "$APPDIR.home"   ] && export HOME="$APPDIR.home"
[ -d "$APPDIR.config" ] && export XDG_CONFIG_HOME="$APPDIR.config"

export XDG_CONFIG_DIRS="$APPDIR/etc${XDG_CONFIG_DIRS:+:$XDG_CONFIG_DIRS}"
export TERMINFO_DIRS="$APPDIR/usr/share/terminfo${TERMINFO_DIRS:+:$TERMINFO_DIRS}"

# If we're already in tmux/screen, run zsh directly instead.
if [ "$TMUX" ] || case "$TERM" in tmux-*|screen-*) true;; *) false;; esac; then
    exec "$APPDIR/usr/bin/zsh" -l
else
    exec "$APPDIR/usr/bin/tmux" "$@"
fi
