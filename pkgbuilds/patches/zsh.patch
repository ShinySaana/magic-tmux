++	bicat(appdir, SITESCRIPT_DIR),
+ #endif
+ #ifdef SCRIPT_DIR
+-	SCRIPT_DIR,
++	bicat(appdir, SCRIPT_DIR),
+ #endif
+ 	0 };
+     const char **sp;
