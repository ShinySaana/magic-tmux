++	*fpathptr++ = zjoin(strs, '/', 0);
++    }
+ #   else
+-    for (j = 0; j < fpathlen; j++)
+-	*fpathptr++ = tricat(FPATH_DIR, "/", fpath_subdirs[j]);
++    for (j = 0; j < fpathlen; j++) {
++	char *strs[] = { appdir, FPATH_DIR + 1, fpath_subdirs[j], NULL };
++	*fpathptr++ = zjoin(strs, '/', 0);
++    }
+ #   endif
+ #  else
+-    *fpathptr++ = ztrdup(FPATH_DIR);
++    *fpathptr++ = bicat(appdir, FPATH_DIR);
+ #  endif
+ # endif
+     *fpathptr = NULL;
+@@ -1043,7 +1048,7 @@ setupvals(char *cmd, char *runscript, char *zsh_name)
+ 
+     mailpath = mkarray(NULL);
+     psvar    = mkarray(NULL);
+-    module_path = mkarray(ztrdup(MODULE_DIR));
++    module_path = mkarray(bicat(appdir, MODULE_DIR));
+     modulestab = newmoduletable(17, "modules");
+     linkedmodules = znewlinklist();
+ 
+@@ -1321,8 +1326,10 @@ run_init_scripts(void)
+ 	} else
+ 	    source("/etc/suid_profile");
+     } else {
++	char *appdir = getenv("APPDIR");
+ #ifdef GLOBAL_ZSHENV
+-	source(GLOBAL_ZSHENV);
++	// Source from APPDIR first
++	source(bicat(appdir, GLOBAL_ZSHENV));
+ #endif
+ 
+ 	if (isset(RCS) && unset(PRIVILEGED))
+@@ -1343,7 +1350,7 @@ run_init_scripts(void)
+ 	if (islogin) {
+ #ifdef GLOBAL_ZPROFILE
+ 	    if (isset(RCS) && isset(GLOBALRCS))
+-		    source(GLOBAL_ZPROFILE);
++		    source(bicat(appdir, GLOBAL_ZPROFILE));
+ #endif
+ 	    if (isset(RCS) && unset(PRIVILEGED))
+ 		sourcehome(".zprofile");
+@@ -1351,7 +1358,7 @@ run_init_scripts(void)
+ 	if (interact) {
+ #ifdef GLOBAL_ZSHRC
+ 	    if (isset(RCS) && isset(GLOBALRCS))
+-		source(GLOBAL_ZSHRC);
++		source(bicat(appdir, GLOBAL_ZSHRC));
+ #endif
+ 	    if (isset(RCS) && unset(PRIVILEGED))
+ 		sourcehome(".zshrc");
+@@ -1359,7 +1366,7 @@ run_init_scripts(void)
+ 	if (islogin) {
+ #ifdef GLOBAL_ZLOGIN
+ 	    if (isset(RCS) && isset(GLOBALRCS))
+-		source(GLOBAL_ZLOGIN);
++		source(bicat(appdir, GLOBAL_ZLOGIN));
+ #endif
+ 	    if (isset(RCS) && unset(PRIVILEGED))
+ 		sourcehome(".zlogin");
